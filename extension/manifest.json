{
  "manifest_version": 3,
  "name": "BigOffer — save jobs, fill forms",
  "short_name": "BigOffer",
  "version": "1.1.0",
  "description": "Save the job you are looking at to your BigOffer board, and fill application forms with your contacts and saved answers.",
  "action": { "default_title": "BigOffer", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://bigoffer-nu.vercel.app/*"]
}
