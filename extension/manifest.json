{
  "manifest_version": 3,
  "name": "BigOffer — save this job",
  "short_name": "BigOffer",
  "version": "1.0.0",
  "description": "Save the job you are looking at to your BigOffer board in one click.",
  "action": { "default_title": "Save to BigOffer", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab"]
}
