# Written by `pnpm db:env` for local Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Trigger.dev (cloud.trigger.dev → project → API keys → DEV)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Optional
JOOBLE_API_KEY=
# Adzuna (developer.adzuna.com): both needed, otherwise the source is skipped
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Scrape interval multiplier (>= 1, default 1): 2 = scrape half as often, to fit the Trigger.dev free credit
SCRAPE_INTERVAL_MULTIPLIER=
SCRAPER_USER_AGENT=

# AI (Google AI Studio → aistudio.google.com/apikey). PUBLIC = free tier, job postings only.
GEMINI_API_KEY_PUBLIC=
# PRIVATE = paid tier (no training on data) for CVs/emails/screenshots — later plans; leave empty for now
GEMINI_API_KEY_PRIVATE=
# Optional overrides
AI_MODEL_PUBLIC=
AI_MODEL_PRIVATE=
AI_DAILY_LIMIT=
AI_BATCH_SIZE=
AI_MIN_INTERVAL_MS=

# Telegram bot (BotFather). Empty token = alerts and digest are skipped. SITE_URL (public web origin) is required with a token.
TELEGRAM_BOT_TOKEN=
SITE_URL=
