# Copy to .env.local, or generate it from the running local stack: `pnpm db:env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# optional: instant re-sync after saving search settings
TRIGGER_SECRET_KEY=
# AI for personal data (CV, letters, recruiter messages): PAID Gemini key with no training on data.
# Without it these features show "AI unavailable". Never put the free key here.
GEMINI_API_KEY_PRIVATE=
AI_MODEL_PRIVATE=
# Paid-AI requests per user per UTC day (CV parsing, letters, form answers, recruiter messages). Default 100.
PRIVATE_AI_DAILY_LIMIT=
# Optional: Microsoft Clarity project id (https://clarity.microsoft.com) for click/scroll heatmaps in production.
NEXT_PUBLIC_CLARITY_ID=
# Telegram bot (optional). Without the token the bot sends nothing; without the username the profile hides "Connect".
TELEGRAM_BOT_TOKEN=
# Random string; also passed to setWebhook as secret_token. The webhook answers 401 without it.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional: finds company recruiters (public LinkedIn profiles) for "Contact the recruiter".
# First key set wins: Tavily (1000 free searches/month, https://app.tavily.com), Serper (https://serper.dev),
# Brave Search (https://api-dashboard.search.brave.com).
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
