# Copy to .env.local, or generate it from the running local stack: `pnpm db:env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# optional: instant re-sync after saving search settings
TRIGGER_SECRET_KEY=
# AI for personal data (CV, letters, recruiter messages): PAID Gemini key with no training on data.
# Without it these features show "AI unavailable". Never put the free key here.
GEMINI_API_KEY_PRIVATE=
AI_MODEL_PRIVATE=
# Paid-AI requests per user per UTC day (CV parsing, letters, form answers, recruiter messages). Default 100.
PRIVATE_AI_DAILY_LIMIT=
# Telegram bot (optional). Without the token the bot sends nothing; without the username the profile hides "Connect".
TELEGRAM_BOT_TOKEN=
# Random string; also passed to setWebhook as secret_token. The webhook answers 401 without it.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
